# Copy to .env and fill in real values (never commit .env)
# Kalshi — https://docs.kalshi.com/
KALSHI_API_KEY=YOUR_KALSHI_API_KEY_ID
# File path is tried first, then ./kalshi_private_key.pem. Very short KALSHI_PRIVATE_KEY_PEM is ignored (shell/.env placeholders).
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...one line with \\n...\n-----END RSA PRIVATE KEY-----"

KALSHI_DEMO=false
KALSHI_BASE_PATH=https://api.elections.kalshi.com/trade-api/v2
MOCK_MODE=false
# Game lines + MARMADROUND (E8 tickers contain 26E8) for tradable E8-vs-game pairing
KALSHI_SCAN_SERIES=KXNCAAMBGAME,KXMARMADROUND
MIN_EQUIV_PROB_GAP=0.015
MAX_TRADABLE_COMPARE_GAP=0.10
MAX_ADVANCE_OVER_WIN=0.02
SCAN_LOOP_INTERVAL_SEC=120

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TRADE_MODE=off
TRADE_ALERT_TYPES=equiv_gap,ordering_violation
TRADE_EXECUTION=taker
TRADE_MAX_CONTRACTS=1
TRADE_MAX_SPEND_CENTS=500
TRADE_ALLOCATION_PCT=0
TRADE_PRICE_BUFFER_CENTS=1
TRADE_MAX_ORDERS_PER_SCAN=3
