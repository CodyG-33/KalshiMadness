# Copy to .env and fill in real values (never commit .env)
# Kalshi — https://docs.kalshi.com/
KALSHI_API_KEY=YOUR_KALSHI_API_KEY_ID
KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# KALSHI_PRIVATE_KEY_PATH=

KALSHI_DEMO=false
KALSHI_BASE_PATH=https://api.elections.kalshi.com/trade-api/v2
MOCK_MODE=false
KALSHI_SCAN_SERIES=KXNCAAMBGAME
MIN_EQUIV_PROB_GAP=0.04
MAX_ADVANCE_OVER_WIN=0.02
SCAN_LOOP_INTERVAL_SEC=120

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TRADE_MODE=off
TRADE_ALERT_TYPES=equiv_gap,ordering_violation,advance_monotonicity
TRADE_EXECUTION=taker
TRADE_MAX_CONTRACTS=1
TRADE_MAX_SPEND_CENTS=500
TRADE_ALLOCATION_PCT=0
TRADE_PRICE_BUFFER_CENTS=1
TRADE_MAX_ORDERS_PER_SCAN=3
